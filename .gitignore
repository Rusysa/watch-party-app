# ============================================================
# Debrid Watch Party — .gitignore
# ============================================================
# Stack: Go + Wails · Vite/Node.js frontend · Docker (signaler)
# ============================================================

# ─── Go ─────────────────────────────────────────────────────
# Compiled binaries & build output
watchparty/build/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Go workspace files (only commit go.sum if using modules)
# go.sum is intentionally tracked

# ─── Wails ──────────────────────────────────────────────────
watchparty/build/bin/
watchparty/frontend/dist/
watchparty/frontend/wailsjs/

# ─── Node.js / npm ──────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
*.tsbuildinfo

# Lock files: keep package-lock.json but ignore ephemeral checksums
frontend/package.json.md5
watchparty/frontend/package.json.md5

# ─── Vite / Frontend build ───────────────────────────────────
dist/
.vite/
.cache/

# ─── Environment & secrets ───────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.p12
secrets/

# ─── OS & editor files ───────────────────────────────────────
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~

# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains / GoLand
.idea/
*.iml
*.iws

# ─── Docker ──────────────────────────────────────────────────
# Don't ignore Dockerfiles — they should be committed
# Ignore any local override compose files
docker-compose.override.yml
.docker/

# ─── Logs & temporary files ──────────────────────────────────
*.log
logs/
tmp/
temp/
*.tmp
*.swp
*.swo

# ─── Render deployment (keep config files) ────────────────────
# render.yaml IS committed intentionally
# Add any generated deployment artifacts here if needed
